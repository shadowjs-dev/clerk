{
  "name": "@shadow-js/clerk",
  "version": "1.0.2",
  "description": "Clerk authentication for your app, with a provider, hooks, UI components and server helpers",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/prod/index.js"
    },
    "./server": {
      "types": "./dist/dev/server.d.ts",
      "development": "./dist/dev/server.js",
      "default": "./dist/prod/server.js"
    },
    "./convex": {
      "types": "./dist/dev/convex.d.ts",
      "development": "./dist/dev/convex.js",
      "default": "./dist/prod/convex.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test-types.json",
    "typecheck:types": "tsc -p tsconfig.test-types.json",
    "lint": "biome check .",
    "test": "vitest run --project unit --project dom --project server",
    "test:gc": "vitest run --project gc --passWithNoTests",
    "test:perf": "vitest run --project perf --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:perf && npm run test:gc"
  },
  "peerDependencies": {
    "@clerk/backend": ">=2",
    "@clerk/clerk-js": ">=5",
    "@clerk/ui": ">=1.39.1",
    "@shadow-js/convex": "^1.0.2",
    "@shadow-js/core": "^1.0.2",
    "@shadow-js/web": "^1.0.2"
  },
  "peerDependenciesMeta": {
    "@clerk/backend": {
      "optional": true
    },
    "@clerk/clerk-js": {
      "optional": true
    },
    "@clerk/ui": {
      "optional": true
    },
    "@shadow-js/convex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@clerk/backend": "3.23.1",
    "@clerk/clerk-js": "6.38.1",
    "@clerk/ui": "1.39.1",
    "@shadow-js/compiler": "^1.0.2",
    "@shadow-js/convex": "^1.0.2",
    "@shadow-js/core": "^1.0.2",
    "@shadow-js/router": "^1.0.2",
    "@shadow-js/testing": "^1.0.2",
    "@shadow-js/web": "^1.0.2",
    "@testing-library/dom": "10.4.2",
    "@types/node": "^24.0.0",
    "esbuild": "0.27.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "homepage": "https://clerk.shadowjs.net",
  "keywords": [
    "shadowjs",
    "clerk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadowjs-dev/clerk.git"
  },
  "bugs": {
    "url": "https://github.com/shadowjs-dev/clerk/issues"
  }
}
